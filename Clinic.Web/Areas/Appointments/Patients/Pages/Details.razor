@page "/Appointments/Patients/details/{id:guid}"
@using Clinic.Web.Areas.Appointments.Patients.Components
@using Clinic.ViewModels
@using Clinic.ViewModels.Appointments
@using Clinic.Web.Models;

@namespace Clinic.Web.Areas.Appointments.Patients.Pages
@inject ILogger<Details> Logger
@inject IJSRuntime JSRuntime
@inherits BlazorPage

<div class="record-detail-toolbar">
    <span class="record-detail-toolbar-label">Patient record</span>
    <div>
        <Button Color="Color.Light" Clicked="CloseClick">Close</Button>
        <Button Color="Color.Danger" Type="ButtonType.Button" Class="delete-record-button" Clicked="() => DeleteClick(Item.Id)">Delete patient</Button>
    </div>
</div>

<PatientInfo @ref="info" Item="Item" />

@page "/Appointments/Visits/new"
@using Clinic.Web.Areas.Appointments.Visits
@using Clinic.ViewModels;
@inject ILogger<Create> Logger
@inject IJSRuntime JSRuntime

@inherits Clinic.Web.Models.BlazorPage

@namespace Clinic.Web.Areas.Appointments.Visits.Pages
@using Clinic.ViewModels.Appointments
@using Clinic.ViewModels.Appointments.Patients;

<PageTitle>Record a visit | Clinic</PageTitle>

<section class="form-page">
    <header class="form-page-heading">
        <div>
            <p class="eyebrow">PATIENT CARE</p>
            <h1>Record a visit</h1>
            <p>Connect the visit with a patient and record the essential details.</p>
        </div>
        <div class="form-heading-actions">
            <Button Color="Color.Light" Clicked="() => NavigationManager.NavigateTo(_pageState.PreviousPage())">Cancel</Button>
            <Button Color="Color.Primary" Type="ButtonType.Submit" form="createForm">
                <Icon Name="IconName.CalendarCheck" />
                Save visit
            </Button>
        </div>
    </header>

    @if (Item == null)
    {
        <div class="form-loading"><Spinner /></div>
    }
    else
    {
        <div class="form-layout form-layout-visit">
            <EditForm Model="Item" OnValidSubmit="@CreateClick" id="createForm" class="clinic-form">
                <DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(SaveError))
                {
                    <div class="alert alert-danger" role="alert">@SaveError</div>
                }
                <section class="form-card" aria-labelledby="visit-details-title">
                    <div class="form-card-heading">
                        <h2 id="visit-details-title">Visit details</h2>
                        <p>Choose the patient and add the visit information.</p>
                    </div>

                    <div class="form-card-body">
                        <div class="form-section">
                            <h3>Patient</h3>
                            @if (!RoutedPatientId.HasValue)
                            {
                                <Field>
                                    <FieldLabel>Search patient</FieldLabel>
                                    <Autocomplete TItem="PatientSummary"
                                                  TValue="Guid"
                                                  Data="@PatientOptions.Items"
                                                  TextField="@((i) => i.FullName)"
                                                  ValueField="@((i) => i.Id)"
                                                  @bind-SelectedValue="@Item.PatientId"
                                                  SearchChanged="(s) => LoadPatientOptions(new PaginationInfo { IsSearch = true, SearchString = s })"
                                                  Placeholder="Search by patient name" />
                                    <ValidationMessage For="(() => Item.PatientId)" />
                                    <small class="form-help">Select an existing patient record before continuing.</small>
                                </Field>
                            }
                            else
                            {
                                <div class="selected-patient-note">
                                    <span class="selected-patient-icon"><Icon Name="IconName.User" /></span>
                                    <span><strong>Patient selected</strong><small>This visit will be linked to the selected patient record.</small></span>
                                </div>
                            }
                        </div>

                        <div class="form-section">
                            <h3>Visit information</h3>
                            <div class="form-grid form-grid-two">
                                <Field>
                                    <FieldLabel>Clinician</FieldLabel>
                                    <Select @bind-SelectedValue="@Item.Physician">
                                        <SelectItem Value="@("Dr. Eshetu")">Dr. Eshetu</SelectItem>
                                        <SelectItem Value="@("Dr. Feven")">Dr. Feven</SelectItem>
                                    </Select>
                                    <ValidationMessage For="(() => Item.Physician)" />
                                </Field>
                                <Field>
                                    <FieldLabel>Presenting concern</FieldLabel>
                                    <TextEdit @bind-Text="@Item.PresentIllness" />
                                    <ValidationMessage For="(() => Item.PresentIllness)" />
                                </Field>
                            </div>
                        </div>
                    </div>

                    <div class="form-card-footer">
                        <Button Color="Color.Light" Clicked="() => NavigationManager.NavigateTo(_pageState.PreviousPage())">Cancel</Button>
                        <Button Color="Color.Primary" Type="ButtonType.Submit" form="createForm">Save visit</Button>
                    </div>
                </section>
            </EditForm>

            <aside class="form-side-column">
                <section class="form-note-card">
                    <span class="form-note-icon"><Icon Name="IconName.Clipboard" /></span>
                    <h2>Keep the record clear</h2>
                    <p>Choose the correct patient first, then record a brief, useful summary of the reason for the visit.</p>
                </section>
                <section class="form-note-card form-note-muted">
                    <h2>Patient privacy</h2>
                    <p>Only include information needed for the clinic record. Keep the screen private while working at reception.</p>
                </section>
            </aside>
        </div>
    }
</section>

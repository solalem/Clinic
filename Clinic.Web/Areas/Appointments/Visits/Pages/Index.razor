@page "/Appointments/Visits/index"
@inherits BlazorPage
@inject NavigationManager navigationManager

@namespace Clinic.Web.Areas.Appointments.Visits.Pages
@using Clinic.Web.Models;
@using Clinic.Web.Shared.Components

@using Clinic.Web.Areas.Appointments.Visits.Components

<PageTitle>Visits | Clinic</PageTitle>

<section class="records-page">
    <header class="records-page-heading">
        <div>
            <p class="eyebrow">PATIENT CARE</p>
            <h1>Visits</h1>
            <p>Review visits and continue a patient’s care record.</p>
        </div>
        <Button Color="Color.Primary" Clicked="() => CreateClick()">
            <Icon Name="IconName.CalendarCheck" />
            <span>Record a visit</span>
        </Button>
    </header>

    <Row Class="records-layout">
        <Column Class="records-list-column" ColumnSize="showPreview ? ColumnSize.Is4 : ColumnSize.Is12">
            <div class="records-panel">
                <div class="records-toolbar">
                    <div class="records-toolbar-title">
                        <h2>Visit history</h2>
                        <p>Search visit and patient details.</p>
                    </div>
                    <div class="record-search">
                        <Icon Name="IconName.Search" />
                        <TextEdit @bind-Text="@Visits.PaginationInfo.SearchString"
                                  @onkeydown="(x) => Search(x)"
                                  Placeholder="Search visits" />
                    </div>
                </div>

                <VisitsComponent IsList="showPreview" Visits="Visits" OnSelectClick="x => DetailClick(x)" OnRemoveClick="x => DeleteClick(x)">
                    <Paginator Title="Visits" PaginationInfo="Visits.PaginationInfo" Spread="5" PageSelected="(p)=> ReloadVisits(p)">
                        <Button Size="Size.Small" Color="Color.Primary" Clicked="() => CreateClick()">
                            <Icon Name="IconName.Add" />
                        </Button>
                    </Paginator>
                </VisitsComponent>
            </div>
            <DialogBoxComponent OnDialogResultClick="(context) => DialogResultReceive(context)" @ref="DialogBox" />
        </Column>

        <Column hidden="@(!showPreview)" ColumnSize="ColumnSize.Is8">
            <div class="records-detail-panel">
                <Clinic.Web.Areas.Appointments.Visits.Pages.Details @ref="Details" OnCloseClick="(x) => showPreview = false" OnDeleteClick="(x) => ReloadVisits(visits.PaginationInfo)" />
            </div>
        </Column>
    </Row>
</section>

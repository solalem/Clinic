@page "/Appointments/Visits/details/{id:guid}"
@using Clinic.Web.Areas.Appointments.Visits
@using Clinic.Web.Areas.Appointments.Visits.Components
@using Clinic.ViewModels
@using Clinic.ViewModels.Appointments
@using Clinic.ViewModels.Appointments.Visits;

@namespace Clinic.Web.Areas.Appointments.Visits.Pages
@inject ILogger<Details> Logger
@inject IJSRuntime JSRuntime
@inherits Clinic.Web.Models.BlazorPage

<div class="record-detail-toolbar">
    <span class="record-detail-toolbar-label">Visit record</span>
    <div>
        <Button Color="Color.Light" Clicked="CloseClick">Close</Button>
        <Button Color="Color.Danger" Type="ButtonType.Button" Clicked="() => DeleteClick(Item.Id)">Delete visit</Button>
    </div>
</div>

<VisitInfo @ref="info" Item="Item" />

<section class="form-card procedure-card">
    <div class="form-card-heading procedure-card-heading">
        <div>
            <h2>Procedures</h2>
            <p>Add or review procedures associated with this visit.</p>
        </div>
        <Button Color="Color.Primary" Clicked="() => AddProcedure()">
            <Icon Name="IconName.Add" />
            Add procedure
        </Button>
    </div>
    <div class="records-table-wrap">
        @if (Item.ProcedureList.Count == 0)
        {
            <div class="records-empty">
                <strong>No procedures recorded</strong>
                <p>Add a procedure to include it in this visit record.</p>
            </div>
        }
        else
        {
            <table class="table records-table">
                <thead>
                    <tr>
                        <th>Procedure</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Item.ProcedureList)
                    {
                        if (item == null) continue;
                        <tr @onclick="@(() => EditProcedure(item))">
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td><span class="procedure-edit-hint">Edit</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

<Modal @ref="procedureModal">
    <ModalContent Centered="true" Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>Edit procedure</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <ProcedureForm Item="selectedProcedure" Visit="Item" @ref="procedureForm" OnProcedureEdited="UpdateClick" />
        </ModalBody>
    </ModalContent>
</Modal>

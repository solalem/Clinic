@page "/Appointments/Visits/details/{id:guid}"
@attribute [Authorize(Roles = Clinic.Web.Security.ClinicRoles.Physician)]
@using Clinic.Web.Areas.Appointments.Visits
@using Clinic.Web.Areas.Appointments.Visits.Components
@using Clinic.ViewModels
@using Clinic.ViewModels.Appointments
@using Clinic.ViewModels.Appointments.Visits;

@namespace Clinic.Web.Areas.Appointments.Visits.Pages
@inject ILogger<Details> Logger
@inject IJSRuntime JSRuntime
@inherits Clinic.Web.Models.BlazorPage

<div class="record-detail-toolbar">
    <span class="record-detail-toolbar-label">Visit record</span>
    <div>
        <Button Color="Color.Light" Clicked="CloseClick">Close</Button>
        <Button Color="Color.Danger" Type="ButtonType.Button" Clicked="() => DeleteClick(Item.Id)">Delete visit</Button>
    </div>
</div>

<VisitInfo @ref="info" Item="Item" />

<section class="form-card procedure-card">
    <div class="form-card-heading procedure-card-heading">
        <div>
            <h2>Procedures</h2>
            <p>Add or review procedures associated with this visit.</p>
        </div>
        <Button Color="Color.Primary" Clicked="() => AddProcedure()">
            <Icon Name="IconName.Add" />
            Add procedure
        </Button>
    </div>
    @if (!string.IsNullOrWhiteSpace(ProcedureSaveError))
    {
        <div class="alert alert-danger" role="alert">@ProcedureSaveError</div>
    }
    <div class="records-table-wrap">
        @if (Item.ProcedureList.Count == 0)
        {
            <div class="records-empty">
                <strong>No procedures recorded</strong>
                <p>Add a procedure to include it in this visit record.</p>
            </div>
        }
        else
        {
            <table class="table records-table">
                <thead>
                    <tr>
                        <th>Procedure</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Item.ProcedureList.Count; index++)
                    {
                        var procedureIndex = index;
                        var item = Item.ProcedureList[index];
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td class="procedure-row-actions">
                                <Button Color="Color.Light" Clicked="@(() => EditProcedure(procedureIndex))">Edit</Button>
                                <Button Color="Color.Danger" Clicked="@(() => RemoveProcedure(procedureIndex))">Remove</Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

<Modal @ref="procedureModal">
    <ModalContent Centered="true" Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>@(IsAddingProcedure ? "Add procedure" : "Edit procedure")</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <ProcedureForm Item="selectedProcedure" Visit="Item" @ref="procedureForm" OnProcedureEdited="SaveProcedureAsync" />
        </ModalBody>
    </ModalContent>
</Modal>

<section class="form-card procedure-card">
    <div class="form-card-heading procedure-card-heading">
        <div>
            <h2>Investigations</h2>
            <p>Add or review investigations associated with this visit.</p>
        </div>
        <Button Color="Color.Primary" Clicked="() => AddInvestigation()">
            <Icon Name="IconName.Add" />
            Add investigation
        </Button>
    </div>
    @if (!string.IsNullOrWhiteSpace(InvestigationSaveError))
    {
        <div class="alert alert-danger" role="alert">@InvestigationSaveError</div>
    }
    <div class="records-table-wrap">
        @if (Item.InvestigationList.Count == 0)
        {
            <div class="records-empty">
                <strong>No investigations recorded</strong>
                <p>Add a investigation to include it in this visit record.</p>
            </div>
        }
        else
        {
            <table class="table records-table">
                <thead>
                    <tr>
                        <th>Investigation</th>
                        <th>Description</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var index = 0; index < Item.InvestigationList.Count; index++)
                    {
                        var investigationIndex = index;
                        var item = Item.InvestigationList[index];
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td class="procedure-row-actions">
                                <Button Color="Color.Light" Clicked="@(() => EditInvestigation(investigationIndex))">Edit</Button>
                                <Button Color="Color.Danger" Clicked="@(() => RemoveInvestigation(investigationIndex))">Remove</Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</section>

<Modal @ref="investigationModal">
    <ModalContent Centered="true" Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>@(IsAddingInvestigation ? "Add investigation" : "Edit investigation")</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <InvestigationForm Item="selectedInvestigation" Visit="Item" @ref="investigationForm" OnInvestigationEdited="SaveInvestigationAsync" />
        </ModalBody>
    </ModalContent>
</Modal>

@namespace Clinic.Web.Shared

<div class="clinic-brand">
    <div class="brand-mark" aria-hidden="true"><Icon Name="IconName.Circle" /></div>
    <div>
        <div class="brand-name">Clinic</div>
        <div class="brand-caption">Front desk</div>
    </div>
</div>

<nav class="clinic-navigation" aria-label="Main navigation">
    <div class="nav-section-label">WORKSPACE</div>
    <NavLink class="clinic-nav-link" href="/" Match="NavLinkMatch.All">
        <Icon Name="IconName.Home" />
        <span>Overview</span>
    </NavLink>
    <NavLink class="clinic-nav-link" href="/Appointments/Patients/index">
        <Icon Name="IconName.Users" />
        <span>Patients</span>
    </NavLink>
    <NavLink class="clinic-nav-link" href="/Appointments/Visits/index">
        <Icon Name="IconName.CalendarCheck" />
        <span>Visits</span>
    </NavLink>

    <div class="nav-section-label nav-section-spaced">QUICK ACTIONS</div>
    <NavLink class="clinic-nav-link" href="/Appointments/Patients/new">
        <Icon Name="IconName.UserPlus" />
        <span>New patient</span>
    </NavLink>
    <NavLink class="clinic-nav-link" href="/Appointments/Visits/new">
        <Icon Name="IconName.PlusCircle" />
        <span>Record a visit</span>
    </NavLink>
</nav>

<div class="sidebar-note">
    <div class="sidebar-note-icon"><Icon Name="IconName.Lock" /></div>
    <div>
        <strong>Private workspace</strong>
        <span>Remember to lock the screen when away.</span>
    </div>
</div>
